#!/bin/sh
set -eu

usage() {
  printf '%s\n' 'Usage: tools/harness/validation/run [--help]'
}

case "${1-}" in
  '') ;;
  --help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 64
    ;;
esac

script_dir=${0%/*}
if [ "$script_dir" = "$0" ]; then
  script_dir=.
fi
script_dir=$(CDPATH= cd -- "$script_dir" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/../../.." && pwd)
toolchain_bin=${JUANERAI_TOOLCHAIN_BIN-/Users/huangbo/Dev/Env/homebrew/bin}

if [ ! -d "$toolchain_bin" ] || [ ! -x "$toolchain_bin/node" ]; then
  printf '%s\n' 'canonical validation toolchain is unavailable' >&2
  exit 1
fi

PATH="$toolchain_bin:/usr/bin:/bin"
export PATH
unset XANTHIL_REAL_PI_ACCEPTANCE

trimmed() {
  printf '%s' "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

require_version() {
  actual=$(trimmed "$("$1" --version)") || exit 1
  actual=${actual#v}
  if [ "$actual" != "$2" ]; then
    printf '%s\n' "unexpected $3 version: $actual" >&2
    exit 1
  fi
}

require_version node 26.0.0 node
require_version npm 11.12.1 npm

require_duckdb_version() {
  output=$(trimmed "$(duckdb --version)") || exit 1
  actual=$(printf '%s\n' "$output" | awk 'NF { print $1; exit }') || exit 1
  actual=${actual#v}
  if [ -z "$actual" ] || [ "$actual" != 1.5.2 ]; then
    printf '%s\n' "unexpected duckdb version: $actual" >&2
    exit 1
  fi
}

require_duckdb_version

python_version=$(trimmed "$(python3 --version)") || exit 1
python_version=${python_version#Python }
case "$python_version" in
  [0-9]*.[0-9]*.[0-9]*) ;;
  *)
    printf '%s\n' "unexpected python version: $python_version" >&2
    exit 1
    ;;
esac
python_major=${python_version%%.*}
python_rest=${python_version#*.}
python_minor=${python_rest%%.*}
if [ "$python_major" -lt 3 ] || { [ "$python_major" -eq 3 ] && [ "$python_minor" -lt 9 ]; }; then
  printf '%s\n' "unsupported python version: $python_version" >&2
  exit 1
fi

cd "$repo_root"

require_package_version() {
  actual=$(node -p "require('./$1').$2") || exit 1
  actual=$(trimmed "$actual")
  if [ "$actual" != "$3" ]; then
    printf '%s\n' "unexpected $4 version: $actual" >&2
    exit 1
  fi
}

require_package_version package.json "dependencies['@earendil-works/pi-coding-agent']" 0.84.2 'Pi SDK declaration'
require_package_version node_modules/@earendil-works/pi-coding-agent/package.json version 0.84.2 'Pi SDK installation'
require_package_version package.json "dependencies.typebox" 1.3.7 'TypeBox declaration'
require_package_version node_modules/typebox/package.json version 1.3.7 'TypeBox installation'
require_package_version package.json "devDependencies.typescript" 5.9.3 'TypeScript declaration'
require_package_version node_modules/typescript/package.json version 5.9.3 'TypeScript installation'
require_package_version package.json "devDependencies['@types/node']" 22.19.19 'Node types declaration'
require_package_version node_modules/@types/node/package.json version 22.19.19 'Node types installation'

find . -path ./node_modules -prune -o -type f \( -name '*.mjs' -o -name '*.ts' \) -print |
while IFS= read -r file; do
  node --check "$file"
done

npm run typecheck
node --test tests/unit/xanthil-local-analysis/*.test.ts
node --test tests/contract/xanthil-local-analysis/*.test.ts
node --test tests/integration/xanthil-local-analysis/*.test.ts
node --test tests/e2e/xanthil-local-analysis/*.test.ts
node --test tests/contract/model-pack-contract-enabler/*.test.ts
node --test tests/integration/model-pack-contract-enabler/*.test.ts
node --test tools/harness/project-board/project-control.test.mjs tools/harness/project-board/status-cli.test.mjs
