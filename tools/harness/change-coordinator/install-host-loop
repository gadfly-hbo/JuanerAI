#!/usr/bin/env node
import { createHash } from 'node:crypto';
import { spawn } from 'node:child_process';
import {
  chmod, chown, copyFile, lstat, mkdir, open, readFile, realpath, rename, rm, writeFile,
} from 'node:fs/promises';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

export const HOST_INSTALL_TARGETS = Object.freeze([
  '/private/etc/juanerai/controller-trust.json',
  '/private/etc/juanerai/host-loop.json',
  '/private/etc/juanerai/github-branch-push-key',
  '/private/etc/juanerai/github-pr-api-credential',
  '/Library/LaunchDaemons/com.juanerai.change-coordinator.plist',
  '/usr/local/bin/juanerai-coordinator',
  '/usr/local/libexec/juanerai-change-coordinator',
  '/private/var/db/juanerai/change-coordinator',
  '/private/var/run/juanerai/change-coordinator.sock',
  '/private/var/log/juanerai/change-coordinator.log',
]);
export const ROLLBACK_PRESERVES = Object.freeze([
  'active-pointer', 'state', 'ledger', 'handoff', 'canary-evidence', 'git-history',
]);
const SERVICE_LABEL = 'com.juanerai.change-coordinator';
const BACKUP_ROOT = '/private/var/db/juanerai/change-coordinator-install-backups';
const MAX_FILE_BYTES = 16 * 1024 * 1024;
const RUNTIME_TARGET = '/usr/local/libexec/juanerai-change-coordinator';
const STATE_TARGET = '/private/var/db/juanerai/change-coordinator';
const DIRECTORY_FILES = Object.freeze({
  [RUNTIME_TARGET]: Object.freeze(['adapters.mjs', 'coordinator.mjs', 'host-loop.mjs', 'production.mjs']),
  [STATE_TARGET]: Object.freeze(['active-change.json']),
});

const sha256 = value => createHash('sha256').update(value).digest('hex');
const canonical = value => Array.isArray(value)
  ? `[${value.map(canonical).join(',')}]`
  : value && typeof value === 'object'
    ? `{${Object.keys(value).sort().map(key => `${JSON.stringify(key)}:${canonical(value[key])}`).join(',')}}`
    : JSON.stringify(value);
const closed = (value, keys) => value !== null && typeof value === 'object'
  && !Array.isArray(value) && Object.keys(value).length === keys.length
  && keys.every(key => Object.hasOwn(value, key));

function exactTarget(target) {
  return typeof target === 'string' && HOST_INSTALL_TARGETS.includes(target);
}

function defaultExec(executable, args) {
  return new Promise((resolve, reject) => {
    const child = spawn(executable, args, { env: {}, shell: false, stdio: ['ignore', 'pipe', 'pipe'] });
    const stdout = []; const stderr = [];
    child.stdout.on('data', chunk => stdout.push(Buffer.from(chunk)));
    child.stderr.on('data', chunk => stderr.push(Buffer.from(chunk)));
    child.once('error', reject);
    child.once('close', (code, signal) => resolve({
      code, signal, stdout: Buffer.concat(stdout), stderr: Buffer.concat(stderr),
    }));
  });
}

function realOsBoundary() {
  return {
    readFile, writeFile, mkdir, lstat, realpath, rename, copyFile, chmod, chown, rm, open,
    exec: defaultExec,
    uid: () => process.getuid(),
    gid: () => process.getgid(),
    now: () => new Date().toISOString(),
  };
}

async function syncPath(os, target) {
  const file = await os.open(target, 'r'); await file.sync(); await file.close();
  const directory = await os.open(path.dirname(target), 'r'); await directory.sync(); await directory.close();
}

async function atomicReplace(os, target, bytes, mode) {
  await os.mkdir(path.dirname(target), { recursive: true, mode: 0o755 });
  const stage = `${target}.stage-${process.pid}`;
  await os.writeFile(stage, bytes, { mode });
  await os.chown(stage, 0, 0);
  await os.chmod(stage, mode);
  await syncPath(os, stage);
  await os.rename(stage, target);
  await syncPath(os, target);
  const readback = await os.readFile(target);
  const stat = await os.lstat(target);
  if (!Buffer.from(readback).equals(Buffer.from(bytes)) || stat.uid !== 0 || stat.gid !== 0
    || (stat.mode & 0o777) !== mode || stat.isSymbolicLink()) throw new Error('READBACK_MISMATCH');
  return { sha256: sha256(readback), mode, uid: stat.uid, gid: stat.gid };
}

async function atomicReplaceDirectory(os, target, source, mode) {
  const names = DIRECTORY_FILES[target];
  if (!names) throw new Error('DIRECTORY_TARGET_INVALID');
  await os.mkdir(path.dirname(target), { recursive: true, mode: 0o755 });
  const stage = `${target}.stage-${process.pid}`;
  await os.rm(stage, { recursive: true, force: true });
  await os.mkdir(stage, { recursive: false, mode });
  await os.chown(stage, 0, 0);
  await os.chmod(stage, mode);
  const files = [];
  for (const name of names) {
    const bytes = await os.readFile(path.join(source, name));
    if (bytes.length === 0 || bytes.length > MAX_FILE_BYTES) throw new Error('SOURCE_INVALID');
    const fileMode = target === STATE_TARGET ? 0o600 : 0o644;
    const staged = path.join(stage, name);
    await os.writeFile(staged, bytes, { mode: fileMode });
    await os.chown(staged, 0, 0);
    await os.chmod(staged, fileMode);
    await syncPath(os, staged);
    files.push({ name, sha256: sha256(bytes), mode: fileMode });
  }
  await syncPath(os, stage);
  const displaced = `${target}.prior-${process.pid}`;
  let hadPrior = false;
  try {
    await os.lstat(target);
    await os.rm(displaced, { recursive: true, force: true });
    await os.rename(target, displaced);
    hadPrior = true;
  } catch (error) {
    if (error?.code !== 'ENOENT') throw error;
  }
  try {
    await os.rename(stage, target);
    await syncPath(os, target);
    const stat = await os.lstat(target);
    if (!stat.isDirectory() || stat.uid !== 0 || stat.gid !== 0 || (stat.mode & 0o777) !== mode) throw new Error('READBACK_MISMATCH');
    for (const file of files) {
      const bytes = await os.readFile(path.join(target, file.name));
      if (sha256(bytes) !== file.sha256) throw new Error('READBACK_MISMATCH');
    }
    if (hadPrior) await os.rm(displaced, { recursive: true, force: true });
    return { sha256: sha256(canonical(files)), mode, uid: stat.uid, gid: stat.gid, files };
  } catch (error) {
    await os.rm(target, { recursive: true, force: true });
    if (hadPrior) await os.rename(displaced, target);
    throw error;
  }
}

async function aclReceipt(os, target) {
  const result = await os.exec('/bin/ls', ['-lde', target]);
  if (result.code !== 0) throw new Error('ACL_READBACK_FAILED');
  const text = result.stdout.toString('utf8');
  if (/\b(?:write|writeattr|writeextattr|writeowner|writeacl)\b/i.test(text.split('\n').slice(1).join('\n'))) throw new Error('ACL_WRITE_GRANT_FORBIDDEN');
  return sha256(result.stdout);
}

async function effectiveWriteDenied(os, runtimeUser, target) {
  const result = await os.exec('/usr/bin/sudo', ['-n', '-u', runtimeUser, '/usr/bin/test', '-w', target]);
  if (result.code === 0) throw new Error('EFFECTIVE_WRITE_ALLOWED');
  return true;
}

export function createHostInstaller(osBoundary) {
  const os = osBoundary ?? realOsBoundary();
  const required = ['readFile', 'writeFile', 'mkdir', 'lstat', 'realpath', 'rename', 'copyFile', 'chmod', 'chown', 'rm', 'open', 'exec', 'uid', 'gid', 'now'];
  if (!closed(os, required) || required.some(name => typeof os[name] !== 'function')) throw new Error('INPUT_INVALID');

  const backup = async (target, backupDirectory) => {
    try {
      const stat = await os.lstat(target);
      if (stat.isSymbolicLink()) throw new Error('SYMLINK_FORBIDDEN');
      const prior = stat.isFile() ? await os.readFile(target) : null;
      if (prior && prior.length > MAX_FILE_BYTES) throw new Error('BACKUP_TOO_LARGE');
      const backupPath = prior ? path.join(backupDirectory, sha256(Buffer.from(target))) : null;
      if (backupPath) {
        await os.writeFile(backupPath, prior, { mode: 0o600 });
        await os.chown(backupPath, 0, 0);
        await os.chmod(backupPath, 0o600);
        await syncPath(os, backupPath);
      }
      return {
        target, present: true, type: stat.isDirectory() ? 'directory' : 'file',
        backup_path: backupPath, sha256: prior ? sha256(prior) : null,
        directory_files: stat.isDirectory() && DIRECTORY_FILES[target]
          ? await Promise.all(DIRECTORY_FILES[target].map(async name => {
            const bytes = await os.readFile(path.join(target, name));
            const directory = path.join(backupDirectory, sha256(Buffer.from(target)));
            await os.mkdir(directory, { recursive: true, mode: 0o700 });
            const saved = path.join(directory, name);
            await os.writeFile(saved, bytes, { mode: 0o600 });
            await os.chown(saved, 0, 0); await os.chmod(saved, 0o600); await syncPath(os, saved);
            const child = await os.lstat(path.join(target, name));
            return { name, backup_path: saved, sha256: sha256(bytes), mode: child.mode & 0o777 };
          })) : [],
        uid: stat.uid, gid: stat.gid, mode: stat.mode & 0o777,
        acl_sha256: await aclReceipt(os, target),
      };
    } catch (error) {
      if (error?.code === 'ENOENT') return {
        target, present: false, type: null, backup_path: null, sha256: null,
        uid: null, gid: null, mode: null, acl_sha256: null,
      };
      throw error;
    }
  };

  return Object.freeze({
    async install(plan) {
      if (os.uid() !== 0 || os.gid() !== 0) throw new Error('ROOT_REQUIRED');
      if (!closed(plan, ['sources', 'modes', 'runtime_user', 'runtime_uid', 'runtime_gid'])
        || !closed(plan.sources, Object.keys(plan.sources)) || !closed(plan.modes, Object.keys(plan.modes))
        || Object.keys(plan.sources).some(target => !exactTarget(target))
        || Object.keys(plan.modes).some(target => !exactTarget(target))
        || typeof plan.runtime_user !== 'string' || !Number.isSafeInteger(plan.runtime_uid)
        || !Number.isSafeInteger(plan.runtime_gid)) throw new Error('INPUT_INVALID');
      const installationId = sha256(canonical({ at: os.now(), sources: plan.sources })).slice(0, 32);
      const backupDirectory = path.join(BACKUP_ROOT, installationId);
      await os.mkdir(backupDirectory, { recursive: true, mode: 0o700 });
      await os.chown(backupDirectory, 0, 0);
      await os.chmod(backupDirectory, 0o700);
      const prior = [];
      for (const target of HOST_INSTALL_TARGETS) prior.push(await backup(target, backupDirectory));
      const manifest = {
        schema_version: '1.0', installation_id: installationId, created_at: os.now(),
        service_label: SERVICE_LABEL, prior, preserves: [...ROLLBACK_PRESERVES],
      };
      const manifestBytes = Buffer.from(canonical(manifest));
      const manifestPath = path.join(backupDirectory, 'manifest.json');
      await atomicReplace(os, manifestPath, manifestBytes, 0o600);

      const installed = [];
      try {
        for (const [target, source] of Object.entries(plan.sources)) {
          if (!path.isAbsolute(source) || !exactTarget(target)) throw new Error('INPUT_INVALID');
          const targetMode = plan.modes[target];
          if (![0o600, 0o640, 0o700, 0o644, 0o755].includes(targetMode)) throw new Error('MODE_INVALID');
          const sourceStat = await os.lstat(source);
          const receipt = sourceStat.isDirectory()
            ? await atomicReplaceDirectory(os, target, source, targetMode)
            : await (async () => {
              const sourceBytes = await os.readFile(source);
              if (sourceBytes.length === 0 || sourceBytes.length > MAX_FILE_BYTES) throw new Error('SOURCE_INVALID');
              return atomicReplace(os, target, sourceBytes, targetMode);
            })();
          const acl_sha256 = await aclReceipt(os, target);
          await effectiveWriteDenied(os, plan.runtime_user, target);
          installed.push({ target, ...receipt, acl_sha256 });
        }
        const unloaded = await os.exec('/bin/launchctl', ['bootout', 'system/' + SERVICE_LABEL]);
        if (![0, 3, 113].includes(unloaded.code)) throw new Error('SERVICE_UNLOAD_FAILED');
        const loaded = await os.exec('/bin/launchctl', ['bootstrap', 'system', '/Library/LaunchDaemons/com.juanerai.change-coordinator.plist']);
        if (loaded.code !== 0) throw new Error('SERVICE_LOAD_FAILED');
        const service = await os.exec('/bin/launchctl', ['print', 'system/' + SERVICE_LABEL]);
        if (service.code !== 0) throw new Error('SERVICE_READBACK_FAILED');
        const socket = await os.lstat('/private/var/run/juanerai/change-coordinator.sock');
        if (!socket.isSocket() || socket.uid !== 0 || socket.gid !== plan.runtime_gid
          || (socket.mode & 0o777) !== 0o660) throw new Error('SOCKET_READBACK_FAILED');
        return { manifest_path: manifestPath, manifest_sha256: sha256(manifestBytes), installed, service_sha256: sha256(service.stdout) };
      } catch (error) {
        await this.rollback({
          manifest_path: manifestPath,
          manifest_sha256: sha256(manifestBytes),
          revocation_receipt_sha256: '0'.repeat(64),
          emergency_pre_activation: true,
        });
        throw error;
      }
    },

    async rollback(request) {
      // Activated rollback requires a provider revoke receipt before local restoration.
      if (os.uid() !== 0 || os.gid() !== 0) throw new Error('ROOT_REQUIRED');
      if (!closed(request, ['manifest_path', 'manifest_sha256', 'revocation_receipt_sha256', 'emergency_pre_activation'])
        || !path.isAbsolute(request.manifest_path)
        || !/^[0-9a-f]{64}$/.test(request.manifest_sha256)
        || !/^[0-9a-f]{64}$/.test(request.revocation_receipt_sha256)
        || typeof request.emergency_pre_activation !== 'boolean') throw new Error('INPUT_INVALID');
      if (!request.emergency_pre_activation && request.revocation_receipt_sha256 === '0'.repeat(64)) throw new Error('REVOCATION_REQUIRED');
      const manifestBytes = await os.readFile(request.manifest_path);
      if (sha256(manifestBytes) !== request.manifest_sha256) throw new Error('MANIFEST_MISMATCH');
      const manifest = JSON.parse(manifestBytes.toString('utf8'));
      if (canonical(manifest) !== manifestBytes.toString('utf8') || manifest.service_label !== SERVICE_LABEL
        || !Array.isArray(manifest.prior) || !sameArray(manifest.preserves, ROLLBACK_PRESERVES)) throw new Error('MANIFEST_INVALID');
      const unloaded = await os.exec('/bin/launchctl', ['bootout', 'system/' + SERVICE_LABEL]);
      if (![0, 3, 113].includes(unloaded.code)) throw new Error('SERVICE_UNLOAD_FAILED');
      for (const prior of [...manifest.prior].reverse()) {
        if (!exactTarget(prior.target)) throw new Error('MANIFEST_INVALID');
        if (prior.target === STATE_TARGET) {
          continue;
        }
        if (prior.type === 'directory' || DIRECTORY_FILES[prior.target]) {
          if (!prior.present) {
            await os.rm(prior.target, { recursive: true, force: true });
            continue;
          }
          const restoreSource = path.dirname(prior.directory_files[0]?.backup_path ?? '');
          if (!restoreSource || prior.directory_files.length !== DIRECTORY_FILES[prior.target]?.length) throw new Error('BACKUP_MISMATCH');
          for (const file of prior.directory_files) {
            const bytes = await os.readFile(file.backup_path);
            if (sha256(bytes) !== file.sha256) throw new Error('BACKUP_MISMATCH');
          }
          await atomicReplaceDirectory(os, prior.target, restoreSource, prior.mode);
          continue;
        }
        if (prior.present) {
          const bytes = await os.readFile(prior.backup_path);
          if (sha256(bytes) !== prior.sha256) throw new Error('BACKUP_MISMATCH');
          await atomicReplace(os, prior.target, bytes, prior.mode);
        } else if (prior.target === '/private/var/run/juanerai/change-coordinator.sock') {
          await os.rm(prior.target, { force: true });
        } else {
          await os.rm(prior.target, { force: true });
        }
      }
      return {
        rolled_back: true,
        preserves: [...ROLLBACK_PRESERVES],
        revocation_receipt_sha256: request.revocation_receipt_sha256,
        readback_sha256: sha256(canonical(manifest.prior)),
      };
    },
  });
}

const sameArray = (left, right) => Array.isArray(left) && left.length === right.length
  && left.every((value, index) => value === right[index]);

async function main() {
  if (process.argv.length !== 3) throw new Error('INPUT_INVALID');
  const requestBytes = await readFile(process.argv[2]);
  const request = JSON.parse(requestBytes.toString('utf8'));
  if (canonical(request) !== requestBytes.toString('utf8')) throw new Error('INPUT_INVALID');
  const installer = createHostInstaller(realOsBoundary());
  const result = request.operation === 'rollback'
    ? await installer.rollback(request.payload)
    : request.operation === 'install'
      ? await installer.install(request.payload)
      : (() => { throw new Error('INPUT_INVALID'); })();
  process.stdout.write(`${canonical(result)}\n`);
}

if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  try {
    await main();
  } catch (error) {
    process.stderr.write(`${canonical({ outcome: 'FAILED', error_code: String(error?.message ?? 'INSTALL_FAILED').replace(/[^A-Z0-9_]/g, '_') })}\n`);
    process.exitCode = 70;
  }
}
